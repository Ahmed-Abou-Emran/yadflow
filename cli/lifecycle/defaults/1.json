{
  "schemaVersion": 10,
  "extends": "yadflow-default@1",
  "phases": [
    { "id": "foundation", "name": "Foundation", "level": "product", "runs": "once", "built": true },
    { "id": "discover", "name": "Discover", "part": "Shape", "level": "feature", "runs": "once", "built": true },
    { "id": "design", "name": "Design", "part": "Shape", "level": "feature", "runs": "once", "built": true },
    { "id": "plan", "name": "Plan", "part": "Shape", "level": "feature", "runs": "once", "built": true },
    { "id": "build", "name": "Build", "part": "Build", "level": "feature", "runs": "loop", "over": ["story", "repo"], "built": true },
    { "id": "release", "name": "Release", "part": "Run", "level": "feature", "runs": "loop", "over": ["release"], "built": false },
    { "id": "operate", "name": "Operate", "part": "Run", "level": "feature", "runs": "once", "built": false }
  ],
  "steps": [
    { "id": "foundation", "name": "Foundation", "phase": "foundation", "kind": "author",
      "artifact": { "type": "set", "path": "foundation/",
        "files": ["purpose.md", "market.md", "scope.md", "mvp.md", "roadmap.md", "stack.md", "repos.md", "risks.md"],
        "optional": ["market.md", "risks.md"] },
      "optional": false, "gate": { "riskTags": [] }, "skills": ["yad-discovery"], "behaviours": ["product-level"],
      "extraPaths": [], "inputs": [], "replaces": "discovery",
      "provider": { "id": "yadflow", "version": 1, "origin": "foundation" } },
    { "id": "discovery", "name": "Discovery", "phase": "foundation", "kind": "author",
      "artifact": { "type": "set", "path": "discovery/",
        "files": ["market-research.md", "competitor-analysis.md", "current-state.md", "feasibility.md", "requirements.md", "roadmap.md"],
        "optional": [] },
      "optional": false, "gate": { "riskTags": [] }, "skills": ["yad-discovery"], "behaviours": ["product-level"],
      "extraPaths": [], "inputs": [], "retired": true,
      "provider": { "id": "yadflow", "version": 1, "origin": "discovery" } },
    { "id": "analysis", "name": "Analysis", "phase": "discover", "kind": "author",
      "artifact": { "type": "file", "path": "analysis.md" },
      "optional": false, "gate": { "riskTags": [] }, "skills": ["yad-analysis"], "behaviours": [],
      "extraPaths": [], "inputs": [],
      "provider": { "id": "yadflow", "version": 1, "origin": "analysis" } },
    { "id": "epic", "name": "Epic", "phase": "discover", "kind": "author",
      "artifact": { "type": "file", "path": "epic.md" },
      "optional": false, "gate": { "riskTags": [] }, "skills": ["yad-epic"], "behaviours": ["work-item-source"],
      "extraPaths": [], "inputs": ["analysis"],
      "provider": { "id": "yadflow", "version": 1, "origin": "epic" } },
    { "id": "architecture", "name": "Architecture", "phase": "design", "kind": "author",
      "artifact": { "type": "file", "path": "architecture.md" },
      "optional": false, "gate": { "riskTags": ["contract"] }, "skills": ["yad-architecture"], "behaviours": ["locks-contract"],
      "extraPaths": [], "inputs": ["epic"],
      "provider": { "id": "yadflow", "version": 1, "origin": "architecture" } },
    { "id": "ui-design", "name": "UI design", "phase": "design", "kind": "author",
      "artifact": { "type": "file", "path": "ui-design.md" },
      "optional": false, "gate": { "riskTags": [] }, "skills": ["yad-ui"], "behaviours": [],
      "extraPaths": ["DESIGN.md", ".sdlc/design-links.json"], "inputs": ["epic", "architecture"],
      "provider": { "id": "yadflow", "version": 1, "origin": "ui-design" } },
    { "id": "stories", "name": "Stories", "phase": "plan", "kind": "author",
      "artifact": { "type": "folder", "path": "stories/", "unit": "story" },
      "optional": false, "gate": { "riskTags": [] }, "skills": ["yad-stories"], "behaviours": ["ends-shape"],
      "extraPaths": [], "inputs": ["epic", "architecture", "ui-design"],
      "provider": { "id": "yadflow", "version": 1, "origin": "stories" } },
    { "id": "test-cases", "name": "Test cases", "phase": "plan", "kind": "author",
      "artifact": { "type": "file", "path": "test-cases.md" },
      "optional": false, "gate": { "riskTags": [] }, "skills": ["yad-test-cases"], "behaviours": ["parallel-with-build"],
      "extraPaths": [".sdlc/test-links.json"], "inputs": ["stories"],
      "provider": { "id": "yadflow", "version": 1, "origin": "test-cases" } },
    { "id": "spec", "name": "Spec", "phase": "build", "kind": "author",
      "artifact": null,
      "optional": false, "gate": null, "skills": ["yad-spec"], "behaviours": ["spec-source"],
      "extraPaths": [], "inputs": ["stories"],
      "provider": { "id": "yadflow", "version": 1, "origin": "spec" } },
    { "id": "tasks", "name": "Tasks", "phase": "build", "kind": "author",
      "artifact": null,
      "optional": false, "gate": null, "skills": ["yad-spec"], "behaviours": [],
      "extraPaths": [], "inputs": ["spec"],
      "provider": { "id": "yadflow", "version": 1, "origin": "tasks" } },
    { "id": "implement", "name": "Implement", "phase": "build", "kind": "author",
      "artifact": null,
      "optional": false, "gate": null, "skills": ["yad-implement"], "behaviours": ["code-change"],
      "extraPaths": [], "inputs": ["tasks"],
      "provider": { "id": "yadflow", "version": 1, "origin": "implement" } },
    { "id": "checks", "name": "Checks", "phase": "build", "kind": "author",
      "artifact": null,
      "optional": false, "gate": null, "skills": ["yad-checks"], "behaviours": ["ci-gates"],
      "extraPaths": [], "inputs": ["implement"],
      "provider": { "id": "yadflow", "version": 1, "origin": "checks" } },
    { "id": "engineer-review", "name": "Engineer review", "phase": "build", "kind": "review",
      "artifact": null,
      "optional": false, "gate": null, "skills": ["yad-engineer-review"], "behaviours": ["merge-gate"],
      "extraPaths": [], "inputs": ["checks"],
      "provider": { "id": "yadflow", "version": 1, "origin": "engineer-review" } }
  ],
  "routes": [
    { "id": "classic", "name": "the 10-step chain",
      "steps": ["epic", "architecture", { "id": "ui-design", "optional": true }, "stories", "test-cases"] },
    { "id": "analysis-first", "name": "the 12-step chain",
      "steps": ["analysis", "epic", "architecture", { "id": "ui-design", "optional": true }, "stories", "test-cases"] },
    { "id": "chore", "name": "the upkeep lane", "steps": ["epic", "stories"] },
    { "id": "spike", "name": "the investigation lane", "steps": ["analysis", "epic", "stories"] },
    { "id": "discovery", "name": "the product front-zero", "steps": ["discovery"], "retired": true },
    { "id": "foundation", "name": "the Product Foundation", "steps": ["foundation"] },
    { "id": "lane", "name": "the Build lane", "steps": ["spec", "tasks", "implement", "checks", "engineer-review"] }
  ],
  "plugins": []
}
